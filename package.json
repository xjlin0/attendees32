{
  "name": "attendees32-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end suite for attendees32, driven against the golden congregation",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:ci-seed": "playwright test --project=ci-seed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
